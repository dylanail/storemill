# Copy to .env. Everything except STOREMILL_SECRET is optional; without a model
# key the rules writers stand in and the admin says so.

# --- required in any real deployment -------------------------------------
# Persistent master key for sealed credentials and visitor fingerprints.
# Generate once with: openssl rand -hex 32
# Production rejects missing, short and placeholder values. Keep the key across deploys.
STOREMILL_SECRET=change-me-to-a-long-random-string

# --- hosts (docker-compose + Caddy) ----------------------------------------
# On Railway leave all of these unset until you attach a domain: stores answer
# at /s/<slug> under the service's public URL, and STOREMILL_PUBLIC_ORIGIN
# defaults to https://<RAILWAY_PUBLIC_DOMAIN>. See docs/DEPLOY.md.
# The admin answers here. Point an A record at the server.
STOREMILL_ADMIN_HOST=admin.yourbrand.com
# Stores answer at <slug>.<this>. Point a wildcard A record (*.stores.yourbrand.com) at the server.
STOREMILL_STOREFRONT_HOST=stores.yourbrand.com
# What custom domains CNAME to. Defaults to edge.<STOREMILL_STOREFRONT_HOST>; point it at the server too.
STOREMILL_EDGE_HOST=edge.stores.yourbrand.com
# The server's public IP, for registrars that need an A record at the apex.
STOREMILL_EDGE_IP=
# Where forwarded domains redirect to when there is no storefront host.
STOREMILL_PUBLIC_ORIGIN=https://admin.yourbrand.com
# Let's Encrypt account email for Caddy.
ACME_EMAIL=you@example.com

# --- models ----------------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Which family answers when both keys are set: anthropic | openai
STOREMILL_TEXT_PROVIDER=anthropic
# Model ids live here, not in code.
STOREMILL_MODEL=claude-opus-5
STOREMILL_OPENAI_MODEL=gpt-5
# Pin one task: STOREMILL_MODEL_RESEARCH=anthropic:claude-fable-5-1 (tasks: PLANNER RESEARCH BRAND PAGES ADS EXTRACTION)

# --- images ----------------------------------------------------------------
# OPENAI_API_KEY above also enables GPT Image 2.
STOREMILL_IMAGE_MODEL=gpt-image-2
GEMINI_API_KEY=
STOREMILL_GOOGLE_IMAGE_MODEL=gemini-3-pro-image-preview
# openai | google | svg
STOREMILL_IMAGE_PROVIDER=

# --- ads, email ------------------------------------------------------------
META_AD_LIBRARY_TOKEN=
STOREMILL_AD_LIBRARY_COUNTRY=GB
# Meta CAPI is pinned to this Graph API version; override while upgrading.
STOREMILL_META_API_VERSION=v25.0
RESEND_API_KEY=
STOREMILL_EMAIL_DOMAIN=

# --- order tracking -------------------------------------------------------
# 17TRACK API v2.4. Registered tracking numbers are refreshed on demand and
# cached in SQLite for 15 minutes before another quota-bearing request.
STOREMILL_17TRACK_API_KEY=

# --- misc ------------------------------------------------------------------
STOREMILL_LOG_LEVEL=info

# Existing-media rebranding: image edits use OPENAI_API_KEY or GEMINI_API_KEY above.
# AI video replacement additionally uses Runway Aleph 2 (2–30 second clips).
RUNWAYML_API_SECRET=
# FFmpeg/FFprobe are included in Docker. Override executable paths if needed locally.
# STOREMILL_FFMPEG=/usr/bin/ffmpeg
# STOREMILL_FFPROBE=/usr/bin/ffprobe
